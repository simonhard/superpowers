#!/usr/bin/env bash
# PreToolUse hook on AskUserQuestion: writing-plans ends with the handoff block, not a question.
#
# Once writing-plans has written the plan and created its tasks, the answer ends
# with the handoff block: a line naming the plan, the "Changes?" sentence,
# "/clear, then:", and a code block holding exactly one command that starts the
# execution skill in a new session. Starting that session is the human partner's
# go, so any AskUserQuestion at this point (the retired three-option execution
# menu, an improvised phase menu, "shall I start?") asks for a go the next
# session already gives. This hook blocks it and teaches the block.
#
# Decision order:
#   1. SUPERPOWERS_ROUTING_GUARD=0 → allow.
#   2. tool_name != "AskUserQuestion" → allow.
#   3. Routing file absent (two-location lookup, same as sibling gates) → allow (dormant).
#   4. Scan transcript: armed = a writing-plans signal, a TaskCreate after it, and
#      no execution-skill invocation after it. Not armed → allow.
#   5. Armed + question contains the token "CLARIFICATION" → allow (genuine mid-plan question).
#   6. Otherwise → block (exit 2). Stderr carries the handoff block. Its command names
#      executing-plans only when the routing file sets "parallelSession": "executing-plans";
#      a missing key, any other value or unreadable JSON names subagent-driven-development.
#
# Opt-in umbrella: same routing file that gates model-routing (docs/superpowers/model-routing.json
# or ~/.claude/superpowers/model-routing.json; the first file found is the only one read).
# Present → active. Absent → dormant. Any error before the decision fails open (allow).
#
# Escape hatch: SUPERPOWERS_ROUTING_GUARD=0

TRACE_LOG="${SUPERPOWERS_USERGATE_TRACE_LOG:-/tmp/claude-hooks/user-gate-trace.log}"
mkdir -p "$(dirname "$TRACE_LOG")" 2>/dev/null || true
trace() {
    local tid="${1:-?}" event="${2:-?}" reason="${3:-}"
    printf '%s | pre-handoff | task=%s | %s%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tid" "$event" \
        "${reason:+ | $reason}" >> "$TRACE_LOG" 2>/dev/null || true
}

# The allow decision on stdout. A function, not a variable: shellcheck reads a
# JSON string kept in a variable as broken quoting (SC2089/SC2090).
allow() {
    printf '%s\n' '{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "allow"}}'
}

if [[ "${SUPERPOWERS_ROUTING_GUARD:-1}" == "0" ]]; then
    trace "?" "skip" "guard=0"
    allow; exit 0
fi

trap 'trace "?" "error" "trap-ERR"; allow; exit 0' ERR

INPUT=$(cat)

# One jq pass for the scalar input fields (was three separate jq spawns).
# One field per line, embedded CR/LF flattened to spaces. NOTE: \x01
# separators are not an option here — bash 3.2 uses \x01 internally
# (CTLESC) and IFS=$'\x01' silently fails to split on stock macOS bash.
# jq parse failure fails the assignment → ERR trap → allow.
# Trailing `tr -d '\r'` strips the CRLF that native Windows jq/python3
# emit (no-op elsewhere); `exit "${PIPESTATUS[N]}"` re-exports the
# producer's exit status so the fail-open fallbacks keep firing.
FIELDS=$(echo "$INPUT" | jq -r '[(.tool_name // ""), (.cwd // ""), (.transcript_path // "")] | map(tostring | gsub("\\r|\\n"; " ")) | .[]' 2>/dev/null | tr -d '\r'; exit "${PIPESTATUS[1]}")
{ IFS= read -r TOOL_NAME; IFS= read -r CWD; IFS= read -r TRANSCRIPT_PATH; } <<< "$FIELDS" || true

[[ "$TOOL_NAME" != "AskUserQuestion" ]] && { trace "?" "skip" "tool=$TOOL_NAME"; allow; exit 0; }

# Locate routing file: project first, then user-level default. First found wins.
[[ -z "$CWD" ]] && CWD="$PWD"
ROUTING_FILE="$CWD/docs/superpowers/model-routing.json"
if [[ ! -f "$ROUTING_FILE" ]]; then
    ROUTING_FILE="$HOME/.claude/superpowers/model-routing.json"
fi

if [[ ! -f "$ROUTING_FILE" ]]; then
    trace "?" "skip" "no-routing-file"
    allow; exit 0
fi

[[ -z "$TRANSCRIPT_PATH" || ! -f "$TRANSCRIPT_PATH" ]] && {
    trace "?" "skip" "no-transcript"
    allow; exit 0
}

# Walk the transcript to determine armed state.
# arm_pos:    last position of a writing-plans signal (Skill tool_use OR a genuine
#             slash-command user message, as slash commands inject user messages)
# disarm_pos: last position of an execution signal (subagent-driven-development /
#             executing-plans / execute-plan Skill tool_use, or the matching
#             genuine slash-command user message)
# last_taskcreate_pos: position of the most recent TaskCreate tool_use. Armed
#             requires it AFTER arm_pos — a stale TaskCreate from an earlier,
#             already-handed-off plan cycle must not arm the guard again when
#             writing-plans is re-invoked for a second plan in the same session.
#
# Note: user message content may be a plain string OR a list of {"type":"text","text":"..."}
# blocks — both are handled.
#
# The file is streamed in BINARY with a substring pre-filter: a line that
# contains none of the signal substrings cannot change arm/disarm state, so it
# skips json.loads. Keeps the scan linear-in-bytes, avoids loading hundreds of
# MB into memory, and — unlike text-mode readlines() — one invalid-UTF-8 byte
# poisons only its own line instead of silently disarming the whole guard.
PY_SCAN='
import json, re, sys

path = sys.argv[1]

# Pre-filter: every signal this scan reacts to lives on a line containing one
# of these literals. Tool_use signals always carry the tool name
# ("Skill"/"TaskCreate"); every user-message signal string starts with
# "superpowers-extended-cc:". One compiled-regex search per line is the
# cheapest formulation that needs no per-line Python overhead.
SIG = re.compile(b"Skill|TaskCreate|superpowers-extended-cc:")

COMMAND_NAME_RE = re.compile(r"<command-name>/?([^<]+)</command-name>")

try:
    f = open(path, "rb")
except Exception:
    print("false\nerror")
    sys.exit(0)

arm_pos = None
disarm_pos = None
last_taskcreate_pos = None

def extract_text(content_val):
    """Return plain text from a content field that is either a string or a list of blocks."""
    if isinstance(content_val, str):
        return content_val
    if isinstance(content_val, list):
        parts = []
        for block in content_val:
            if isinstance(block, dict) and block.get("type") == "text":
                parts.append(block.get("text", ""))
        return " ".join(parts)
    return ""

with f:
    for pos, line in enumerate(f):
        if not SIG.search(line):
            continue
        try:
            e = json.loads(line)
        except Exception:
            continue

        etype = e.get("type", "")

        # --- assistant messages: scan tool_use entries ---
        if etype == "assistant":
            for c in (e.get("message") or {}).get("content") or []:
                if not isinstance(c, dict) or c.get("type") != "tool_use":
                    continue
                name = c.get("name", "")
                inp = c.get("input") or {}

                # writing-plans arm signals
                if name == "Skill":
                    skill_val = inp.get("skill", "") or ""
                    if (skill_val == "writing-plans"
                            or skill_val.endswith(":write-plan")
                            or "writing-plans" in skill_val):
                        arm_pos = pos

                # TaskCreate (compared against arm_pos at the end)
                if name == "TaskCreate":
                    last_taskcreate_pos = pos

                # Execution disarm signals — Skill tool_use
                if name == "Skill":
                    skill_val = inp.get("skill", "") or ""
                    if (skill_val in ("subagent-driven-development", "executing-plans", "execute-plan")
                            or skill_val.endswith(":subagent-driven-development")
                            or skill_val.endswith(":executing-plans")
                            or skill_val.endswith(":execute-plan")):
                        disarm_pos = pos

        # --- user messages: check for slash-command skill invocations ---
        if etype == "user":
            msg = e.get("message") or {}
            # content may be string or list of blocks
            raw_content = msg.get("content", "")
            text = extract_text(raw_content)

            # Naming a skill is not invoking it: only a message that opens with
            # the <command-message>/<command-name> tag counts.
            if text.lstrip().startswith("Base directory for this skill:"):
                continue

            stripped_text = text.lstrip()
            cmd_name = None
            if stripped_text.startswith("<command-message>") or stripped_text.startswith("<command-name>"):
                cmd_match = COMMAND_NAME_RE.search(text)
                cmd_name = cmd_match.group(1) if cmd_match else None

            # writing-plans arm via genuine slash-command invocation
            if cmd_name in ("superpowers-extended-cc:writing-plans", "superpowers-extended-cc:write-plan"):
                arm_pos = pos

            # execution disarm via genuine slash-command invocation
            if cmd_name in ("superpowers-extended-cc:subagent-driven-development", "superpowers-extended-cc:executing-plans"):
                disarm_pos = pos

# armed iff: arm_pos set AND (no disarm OR disarm before arm)
#            AND the most recent TaskCreate came after the most recent arm
armed = (
    arm_pos is not None
    and (disarm_pos is None or disarm_pos < arm_pos)
    and last_taskcreate_pos is not None
    and last_taskcreate_pos > arm_pos
)

print(("true" if armed else "false") + "\n" + str(arm_pos))
'

SCAN_RESULT=$(python3 -c "$PY_SCAN" "$TRANSCRIPT_PATH" 2>/dev/null | tr -d '\r'; exit "${PIPESTATUS[0]}") || SCAN_RESULT=$'false\nerror'
{ IFS= read -r ARMED; IFS= read -r ARM_POS; } <<< "$SCAN_RESULT" || true

if [[ "$ARMED" != "true" ]]; then
    trace "?" "not-armed" "arm_pos=${ARM_POS:-null}"
    allow; exit 0
fi

# Armed — only a question carrying the CLARIFICATION token passes.
Q0_QUESTION=$(echo "$INPUT" | jq -r '.tool_input.questions[0].question // ""' 2>/dev/null | tr -d '\r'; exit "${PIPESTATUS[1]}")

if [[ "$Q0_QUESTION" == *"CLARIFICATION"* ]]; then
    trace "?" "clarification-escape" "CLARIFICATION token in question"
    allow; exit 0
fi

# The routing file names the execution skill. Only "parallelSession":
# "executing-plans" selects inline execution; a missing key, any other value or
# unreadable JSON falls back to subagent-driven-development.
EXEC_SKILL="subagent-driven-development"
FORCED=$(jq -r '.parallelSession // empty' "$ROUTING_FILE" 2>/dev/null | tr -d '\r') || FORCED=""
if [[ "$FORCED" == "executing-plans" ]]; then
    EXEC_SKILL="executing-plans"
fi

trace "?" "block" "armed=true, question after the plan, command=${EXEC_SKILL}"

{
    echo "EXECUTION HANDOFF: no AskUserQuestion after the plan is written."
    echo ""
    echo "writing-plans ends with the handoff block, not a question. End your answer with:"
    echo ""
    echo "  Plan written to <plan path>."
    echo ""
    echo "  Changes? Tell me here and I'll show this block again. Otherwise, starting the next session is your go."
    echo ""
    echo "  /clear, then:"
    echo ""
    echo '  ```'
    echo "  /superpowers-extended-cc:${EXEC_SKILL} <absolute plan path>"
    echo '  ```'
    echo ""
    echo "Nothing after the code block. Name no model."
    echo "A genuine mid-plan clarification: put the literal token CLARIFICATION in the question and retry."
    echo "Kill switch: SUPERPOWERS_ROUTING_GUARD=0."
    echo "Rationale: docs/model-routing-flow.md"
    echo "(Trace log: $TRACE_LOG)"
} >&2

exit 2
